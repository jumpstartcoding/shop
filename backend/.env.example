# Copy to backend/.env for local development. Never commit the real .env.

# development | test | production
ENVIRONMENT=development

# Postgres connection. Locally: any Postgres 14+. Production: Neon's *pooled* connection
# string, with the driver prefix changed to postgresql+psycopg:// and ?sslmode=require.
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/shop

# Where the site is served. Used to build links sent to customers (Phase 2).
PUBLIC_BASE_URL=http://localhost:5173

# Shared secret CloudFront adds as the X-Origin-Secret header on /api requests.
# Leave empty locally. In production set a long random value (e.g. `openssl rand -hex 32`)
# in both CloudFront and here; requests without it are refused.
ORIGIN_SECRET=

# Sessions and sign-in throttling
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30
LOGIN_MAX_FAILURES=10
LOGIN_LOCK_MINUTES=15

LOG_LEVEL=INFO

# Tests only: database the test suite may wipe and recreate.
TEST_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/shop_test

# Files: signed PDFs, signature images, logo. "local" for development, "s3" in production.
STORAGE_BACKEND=local
FILES_DIR=.files
FILES_BUCKET=
AWS_REGION=us-east-1

# Email: "file" writes .eml files to FILES_DIR/outbox (open them in any mail app),
# "ses" sends through Amazon SES, "disabled" sends nothing.
EMAIL_BACKEND=file
EMAIL_FROM=Ridgeline Auto Repair <no-reply@example.com>

# Customer links stay valid this many days.
ESTIMATE_LINK_DAYS=45
INVOICE_LINK_DAYS=180
# Website booking/contact forms: max submissions per IP address per hour.
PUBLIC_SUBMISSIONS_PER_HOUR=5

# ---- Added in later phases (not read by the app yet) ----
# STRIPE_SECRET_KEY=           Phase 3
# STRIPE_WEBHOOK_SECRET=       Phase 3
